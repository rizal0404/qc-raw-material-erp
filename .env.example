NODE_ENV=development
APP_VERSION=0.7.0
TZ=Asia/Makassar

# Browser-facing API base URL
VITE_API_BASE_URL=http://localhost:3000/api/v1

# API
API_HOST=0.0.0.0
API_PORT=3000
API_CORS_ORIGIN=http://localhost:5173

# Counter
COUNTER_UNDO_MINUTES=10

# Auth/session
SESSION_COOKIE_NAME=qc_session
SESSION_TTL_HOURS=8
SESSION_TOUCH_MINUTES=5
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax
# SESSION_COOKIE_DOMAIN=.example.com
AUTH_MAX_LOGIN_FAILURES=5
AUTH_LOCK_MINUTES=15
PASSWORD_PEPPER=replace-with-a-long-random-secret-at-least-24-characters

# One-time first admin bootstrap (do not commit actual values)
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_DISPLAY_NAME=Supervisor Admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-strong-password

# PostgreSQL. The default target stays local even when a Supabase URL exists.
DATABASE_TARGET=local
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/qc_raw_material
DATABASE_SSL=false
DB_POOL_MAX=10

# Supabase staging. Use the session pooler for a persistent API on IPv4-only
# networks, or the transaction pooler for serverless deployment.
SUPABASE_DATABASE_URL=postgresql://postgres.project-ref:password@aws-0-region.pooler.supabase.com:5432/postgres
SUPABASE_DATABASE_SSL=true
SUPABASE_DB_POOL_MAX=2
SUPABASE_PROJECT_REF=tejxcxlpoksittppontc
SUPABASE_API_PORT=3137
SUPABASE_WEB_PORT=5174

# Migration commands use MIGRATION_DATABASE_URL when set, otherwise DATABASE_URL.
# For Supabase use the direct connection (preferred) or session pooler, enable SSL,
# and pin the expected project ref to prevent applying migrations to the wrong project.
# MIGRATION_DATABASE_URL=postgresql://postgres:password@db.project-ref.supabase.co:5432/postgres
# MIGRATION_DATABASE_SSL=true
# MIGRATION_EXPECTED_PROJECT_REF=project-ref
